{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Model Residency",
  "version": "0.1.1",
  "identifier": "in.sociobot.local-model-residency",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Local Model Residency",
        "width": 1180,
        "height": 790,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Find local model memory and reloads",
    "longDescription": "Shows resident local models, their runtime processes, memory use, and load or unload events.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": { "appimage": { "bundleMediaFramework": false }, "deb": {} },
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": null },
    "windows": { "digestAlgorithm": "sha256", "certificateThumbprint": null }
  }
}
