{
  "name": "local-model-residency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "tauri": "tauri",
    "test": "playwright test",
    "test:all": "npm run test:unit && npm test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:site && playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
